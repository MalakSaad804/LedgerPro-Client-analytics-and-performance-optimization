PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ledgerpro
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
# used only by npm run seed
ADMIN_EMAIL=admin@ledgerpro.com
ADMIN_PASSWORD=Admin@12345
# business time zone as minutes ahead of UTC (Pakistan = 300)
BUSINESS_TZ_OFFSET_MIN=300
# demo staff created by npm run seed
STAFF_EMAIL=staff@ledgerpro.com
STAFF_PASSWORD=Staff@12345
STAFF2_EMAIL=staff2@ledgerpro.com
# optional: allowed browser origins for the dashboard (comma separated)
# CLIENT_ORIGIN=http://localhost:5174
# optional: Redis for caching (without it the API uses a small in-memory cache)
# REDIS_URL=redis://127.0.0.1:6379
# requests slower than this are logged as SLOW REQUEST
# SLOW_REQUEST_MS=300
